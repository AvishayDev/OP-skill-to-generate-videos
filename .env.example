# Copy to .env for local runs only (git-ignored).
# In Claude Code on the web, put these in the cloud environment's settings
# (environment menu in the session title bar → Edit → environment variables).

# Required — Google AI Studio key for Gemini TTS (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Recommended — Pexels, free photos + stock footage (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Recommended — Pixabay, free photos / illustrations / vectors, no attribution required (https://pixabay.com/api/docs/)
# Wikimedia Commons needs no key.
PIXABAY_API_KEY=

# Recommended — Freesound: background music + sound effects, CC0 / CC BY (https://freesound.org/apiv2/apply)
FREESOUND_API_KEY=

# Optional — Freepik key for Flaticon icons (else free Iconify icons are used)
FREEPIK_API_KEY=

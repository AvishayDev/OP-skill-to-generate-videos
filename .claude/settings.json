{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node pipeline/cli.mjs:*)",
      "Bash(npm test)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(reelkit:*)"
    ]
  },
  "env": {
    "DO_NOT_TRACK": "1",
    "HYPERFRAMES_NO_TELEMETRY": "1"
  }
}
